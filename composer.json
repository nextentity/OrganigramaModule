{
  "name": "company/organigrama-module",
  "description": "Enterprise multi-tenant organizational chart platform with AI-powered technical support triaging and auto-fix capabilities",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3 || ^8.4 || ^8.5",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "psr/container": "^2.0",
    "guzzlehttp/guzzle": "^7.8",
    "ramsey/uuid": "^4.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "worker": "php bin/ticket_worker.php",
    "worker:once": "php bin/ticket_worker.php --once",
    "migrate": "php database/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}

