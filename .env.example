# Driver principal: mysql | sqlite
DB_CONNECTION=mysql

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=organigrama
DB_USERNAME=root
DB_PASSWORD=
DB_CONNECT_TIMEOUT=2

# Fallback automático a SQLite si MySQL no responde
DB_FALLBACK_TO_SQLITE=true
DB_SQLITE_PATH=storage/database/organigrama.sqlite

# Contraseña asignada a los usuarios de prueba del seed
SEED_DEFAULT_PASSWORD=Demo1234!

# =============================================================================
# Módulo de Soporte y Triaging Automatizado con IA
# =============================================================================
# LLM Provider: openai | gemini (dejar en mock/vacío para tests deterministas)
LLM_PROVIDER=openai
LLM_API_KEY=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# GitHub Integration
GITHUB_TOKEN=mock
GITHUB_OWNER=acme-corp
GITHUB_REPO=organigrama-module
GITHUB_API_BASE_URL=https://api.github.com

# Jira Cloud REST API v3 Integration
JIRA_EMAIL=support-bot@example.com
JIRA_API_TOKEN=mock
JIRA_DOMAIN=example.atlassian.net
JIRA_PROJECT_KEY=SUP

